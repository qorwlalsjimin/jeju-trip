rules_version = '2';
// 겨울이 머문 제주 — Firestore 보안 규칙
// 사이트를 연 사람만(익명 로그인) 읽고 쓸 수 있고, 저장되는 값의 형식과 길이를 제한합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 장소 (식당·카페·유원지)
    match /places/{placeId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.cat in ['food', 'cafe', 'fun']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.get('memo', '').size() <= 400
        && request.resource.data.get('link', '').size() <= 500
        && request.resource.data.get('likes', []).size() <= 8;
    }

    // 계획표 (30분 단위 일정)
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.start is string
        && request.resource.data.start.size() == 5
        && request.resource.data.dur is number
        && request.resource.data.dur >= 30
        && request.resource.data.dur <= 720
        && request.resource.data.get('title', '').size() <= 60
        && request.resource.data.get('placeId', '').size() <= 64;
    }

    // 항공편(flights)과 숙소(stay): 문서 하나씩
    match /trip/{docId} {
      allow read, write: if request.auth != null && docId in ['flights', 'stay'];
    }
  }
}
